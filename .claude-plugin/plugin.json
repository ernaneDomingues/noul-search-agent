{
  "name": "noul-search-agent",
  "displayName": "Noul Search",
  "version": "1.1.0",
  "description": "Scientific literature search across all disciplines with study-design evidence levels, a deterministic Evidence Meter (Noul Meter), cited synthesis, related/cited paper discovery, Open Access PDF download and research dossiers.",
  "author": {
    "name": "Ernane Domingues",
    "url": "https://github.com/ernaneDomingues"
  },
  "homepage": "https://github.com/ernaneDomingues/noul-search-agent",
  "repository": "https://github.com/ernaneDomingues/noul-search-agent",
  "license": "Apache-2.0",
  "keywords": ["research", "scientific-literature", "evidence", "pubmed", "openalex", "mcp"],
  "commands": ["./commands/noul-search-config.md"],
  "agents": ["./agents/claude-noul-researcher.md"],
  "mcpServers": {
    "noul": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/noul_mcp.py"]
    }
  }
}
